    echo -e "\n`date  +\"%Y/%m/%d %R\"` - ${1}" >> ~/notes/Journal/`date +"%Y"`.md
}

,uz() {
    file="${1%.zip}"

    mkdir ${file}
    cd ${file}
    unzip ../${1}
    
}

